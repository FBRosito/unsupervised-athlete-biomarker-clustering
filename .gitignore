# ========================
# 1. Sensitive data
# ========================
# Blocks real athlete data files, should they ever be placed in this repo by mistake.
dados_base.csv
dados_base_aumentados.csv
dados_extras.csv
dados_extras_aumentados.csv

# Blocks Excel files that may contain raw data
*.xlsx
*.xls

# ========================
# 2. Python Environment
# ========================
venv/
.venv/
env/
.env

__pycache__/
*.py[cod]
*$py.class

# ========================
# 3. Jupyter checkpoints (in case notebooks are added locally)
# ========================
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ========================
# 3b. Pipeline run outputs
# ========================
# Local outputs of notebooks/v2_reanalysis/ scripts -- regenerated by running them, not versioned.
results_v2/

# ========================
# 4. Systems and IDEs
# ========================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ========================
# 5. Figures
# ========================
*.png

# ========================
# 6. Exceptions (Whitelist)
# ========================
# Ensure the synthetic demo dataset is always tracked.
!database/
!database/*.csv
